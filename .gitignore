# Rules for the whole repo. App-specific rules live in web/.gitignore.

# dependencies (root tooling: mermaid validator)
/node_modules

# Python virtual environments
venv/
.venv/
env/

# Python cache & compiled bytecode
__pycache__/
*.pyc

# Camera capture outputs & local images
*.jpg
*.jpeg
*.png
fivepalm_capture_*.jpg
!web/public/frames/*.png

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# MediaPipe model downloaded by scripts/model-training
hand_landmarker.task
pose_landmarker_lite.task
face_landmarker.task

# Gesture GIF demo: third-party memes
scripts/model-training/gifs/

# Trained model (the web kiosk loads the exported gesture_weights.json instead)
gesture_classifier.joblib
