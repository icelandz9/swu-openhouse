# CPE PhotoBooth - Environment Configuration (SWU Open House 2026)
# Copy to .env.local for local runs. On Vercel, add the same keys under Project → Settings → Environment Variables.
# Deploy steps: docs/deploy.md

# ==============================================================================
# 1. Public App URL (the address printed in the QR code)
# ==============================================================================
# Leave empty to use the address the screen was opened with.
# Set it when phones must use a different address, e.g. https://photobooth.vercel.app
NEXT_PUBLIC_APP_URL=

# ==============================================================================
# 2. Photo storage
# ==============================================================================
# local = files in web/data/ on this machine (default, local runs only)
# r2    = Cloudflare R2 (required on Vercel)
STORAGE_DRIVER=local

# Cloudflare R2 (Dashboard > R2 > Manage R2 API Tokens, permission "Object Read & Write")
# Keep the bucket private; phones get photos through this app by code only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=swu-photobooth

# ==============================================================================
# 3. Staff access (/admin and the staff-only APIs: photo list, delete, reset)
# ==============================================================================
# PIN staff type to unlock a browser. Use 6+ digits on a public site.
# Local runs fall back to 1234 when empty; a deployed site refuses logins until it is set.
ADMIN_PIN=

# Random secret that signs the staff cookie. Required on Vercel. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
