# CPE PhotoBooth - Environment Configuration (SWU Open House 2026)

# ==============================================================================
# 1. Public App URL (For attendee mobile phone 4G/5G download via QR Code)
# ==============================================================================
# In production on event day:
# Run: cloudflared tunnel --url http://localhost:3000
# And copy the public tunnel URL here:
NEXT_PUBLIC_APP_URL=https://booth.cpe-swu.com

# ==============================================================================
# 2. Cloud Storage Adapter (Cloudflare R2 / AWS S3 S3-Compatible)
# ==============================================================================
# Set to 'r2' for Cloudflare R2 / AWS S3, or leave 'local' for local disk storage
STORAGE_DRIVER=local

# Cloudflare R2 Credentials (Get from Cloudflare Dashboard > R2 > Manage R2 API Tokens)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=swu-photobooth
R2_PUBLIC_DOMAIN=https://photos.cpe-swu.com

# ==============================================================================
# 3. Staff Admin Dashboard Security
# ==============================================================================
ADMIN_PIN=1234
